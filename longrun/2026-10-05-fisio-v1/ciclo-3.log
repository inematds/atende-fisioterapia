            itens = [{"exercicio": "ponte", "series": 3, "repeticoes": 10, "vezes_dia": 2, "dias": ["seg", "qua", "sex"]},
                     {"exercicio": "retracao-cervical", "series": 2, "repeticoes": 10, "vezes_dia": 1, "dias": ["ter", "qui"]}]
