#!/usr/bin/env bash
# Camada "limite" do goal.md. Imprime LIMITES OK ou o primeiro problema (código ≠ 0).
set -uo pipefail
cd "$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
D=longrun/2026-10-05-fisio-v1
falha() { echo "LIMITE VIOLADO: $*"; exit 1; }
[ -f $D/hash-congelado.txt ] || falha "contrato não congelado (rode $D/congelar.sh)"
source $D/hash-congelado.txt
h=$(cat $(git ls-files tests pytest.ini docs/ESPECIFICACAO.md $D/verificar-limites.sh $D/verificar-independente.py | sort) | sha256sum | cut -c1-16)
[ "$h" = "$HASH" ] || falha "hash do contrato mudou ($h ≠ $HASH)"
git diff --quiet -- tests pytest.ini docs/ESPECIFICACAO.md $D/verificar-independente.py || falha "contrato alterado no working tree"
n=$(python3 -m pytest --collect-only -q 2>/dev/null | grep -oE '^[0-9]+ tests? collected' | grep -oE '^[0-9]+')
[ "$n" = "$TESTES" ] || falha "nº de testes coletados $n ≠ $TESTES"
fora=$( { git diff --name-only "$BASE"; git ls-files --others --exclude-standard; } | sort -u \
  | grep -vE "^($D/|atende$|src/|web/|tools/|exemplos/|README\.md$|VERSION$|Dockerfile$|docker-compose\.yml$|\.env\.exemplo$|\.dockerignore$|\.gitignore$|CLAUDE\.md$|FALHAS\.md$)" )
[ -z "$fora" ] || falha "arquivos fora do escopo: $(echo $fora)"
codigo=$(ls -d atende src web tools 2>/dev/null)
[ -n "$codigo" ] || falha "não há implementação (atende/src/web/tools)"
grep -q "Como rodar no seu ambiente" README.md || falha "README perdeu a seção do dono (Como rodar no seu ambiente)"
# credencial e host externo são barrados também nos arquivos de entrega (Dockerfile, compose, .env.exemplo, .dockerignore)
entrega=$(ls Dockerfile docker-compose.yml .env.exemplo .dockerignore 2>/dev/null)
grep -rnE '^\s*(import|from)\s+(requests|httpx|aiohttp|urllib3|flask|fastapi|django|openai|anthropic|groq|playwright|selenium)\b' $codigo && falha "dependência externa ou SDK de API"
grep -rnE '(OPENAI|ANTHROPIC|GROQ|OPENROUTER)_?API_KEY|sk-[A-Za-z0-9]{20,}|[0-9]{8,10}:[A-Za-z0-9_-]{30,}|graph\.facebook|api\.telegram\.org' $codigo $entrega && falha "chave/credencial ou API externa no código ou na entrega"
grep -rnP 'https?://(?!127\.0\.0\.1|localhost|www\.w3\.org)' $codigo $entrega && falha "URL externa no código ou na entrega"
grep -rn '0\.0\.0\.0' $codigo && falha "bind em 0.0.0.0 no código (só o comando do container pode passar --host)"
grep -rniE '<(script|animate|animateTransform|animateMotion|set)\b' web/exercicios/*.svg 2>/dev/null && falha "SVG com script ou SMIL (seção 21: só animação CSS)"
echo "LIMITES OK (hash $HASH, $TESTES testes, escopo ok, sem API/rede)"

exec
/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
p=Path('src/conversa.py'); s=p.read_text().replace('integracoes, planos, prescricoes','integracoes, planos, prescricoes, exercicios')
s=s.replace(\"    ''')\\n\\n\\ndef paciente_tel\", \"    ''')\\n    if 'exercicio_id' not in {r[1] for r in c.db.execute('PRAGMA table_info(saida)')}:\\n        c.db.execute('ALTER TABLE saida ADD COLUMN exercicio_id TEXT')\\n\\n\\ndef paciente_tel\",1)
s=s.replace('oferta=None, quando=None):','oferta=None, quando=None, exercicio_id=None, historico=True):',1)
s=s.replace('quando,oferta)\\n        VALUES (?,?,?,?,?,?,?)','quando,oferta,exercicio_id)\\n        VALUES (?,?,?,?,?,?,?,?)',1)
s=s.replace('json.dumps(oferta) if oferta else None)).lastrowid','json.dumps(oferta) if oferta else None, exercicio_id)).lastrowid',1)
s=s.replace(\"    registrar(c, p['telefone'], 'saida', texto, quando)\\n\", \"    if historico:\\n        registrar(c, p['telefone'], 'saida', texto, quando)\\n\",1)
s=s.replace('def conversar(c, numero, texto):','def conversar(c, numero, texto, processadas=None):').replace('decidir(c, tel, texto, estado)','decidir(c, tel, texto, estado, processadas)').replace('def decidir(c, tel, texto, estado, processadas):','def decidir(c, tel, texto, estado, processadas=None):')
needle=\"    if any(contem(t, x) for x in ('agendar', 'marcar', 'consulta')):\"
s=s.replace(needle,\"    resposta = exercicios.conversar(c, p, t, processadas)\\n    if resposta is not None:\\n        estado['falhas'] = 0\\n        return [resposta]\\n\"+needle)
p.write_text(s)
p=Path('src/exercicios.py'); s=p.read_text(); s+='''\\n\\ndef conversar(c, paciente, texto, processadas=None):
    \"\"\"Explica apenas itens ativos prescritos; o maior termo casado vence.\"\"\"
    from .conversa import contem, normalizar, enviar
    from .prescricoes import obter as prescricao, link
    catalogo = [e for e in c.catalogo('exercicios') if e['ativo']]
    escolhido, tamanho = None, 0
    for e in catalogo:
        for termo in [e['nome'], *e.get('apelidos', [])]:
            termo = normalizar(termo)
            palavras = len(termo.split())
            if palavras > tamanho and contem(texto, termo):
                escolhido, tamanho = e, palavras
    if escolhido is None and not any(contem(texto, t) for t in ('exercicio', 'exercicios')):
        return None
    receita = prescricao(c, paciente['id']) if paciente else None
    ids = {i['exercicio'] for i in receita['itens']} if receita else set()
    negativa = 'Fale com seu fisioterapeuta. Se precisar, peça um atendente.'
    if escolhido is None:
        itens = {e['id']: e for e in catalogo}
        linhas = [f\"- {itens[i['exercicio']]['nome']} — {link(i['exercicio'])}\"
                  for i in receita['itens'] if i['exercicio'] in itens] if receita else []
        return '\\\\n'.join(linhas) or negativa
    if escolhido['id'] not in ids:
        return negativa
    resposta = '\\\\n'.join([escolhido['nome'],
        *[f'{n}. {passo}' for n, passo in enumerate(escolhido['passos'], 1)],
        'Pare se: ' + '; '.join(escolhido.get('pare_se', [])), link(escolhido['id'])])
    enviar(c, paciente['id'], 'explicacao', resposta,
           exercicio_id=escolhido['id'], historico=False)
    # O webhook não repete o envio que a caixa de saída já tentou (ou bloqueou).
    if processadas is not None:
        processadas.append(resposta)
