def evolution(c, b):
    from .conversa import conversar, registrar
    data = b.get('data') or {}
    key = data.get('key') or {}
    jid = key.get('remoteJid', '')
    ident = key.get('id')
    if b.get('event') != 'messages.upsert' or key.get('fromMe') or jid.endswith('@g.us') or not ident:
