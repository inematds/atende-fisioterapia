    st, tipo, corpo = api.bruto("/exercicios/ponte.mp4")
    assert st == 200 and tipo.startswith("video/mp4") and corpo == (pasta / "ponte.mp4").read_bytes()
    assert api.bruto("/exercicios/gato-camelo.mp4")[0] == 404
