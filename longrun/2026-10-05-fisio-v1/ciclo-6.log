    m = re.fullmatch(r'/api/pacientes/(\d+)', rota)
    if metodo == 'PUT' and m:
        return 200, cadastros.editar_paciente(c, int(m[1]), b)
    m = re.fullmatch(r'/api/(profissionais|servicos|faq)(?:/([^/]+))?', rota)
    if m:
