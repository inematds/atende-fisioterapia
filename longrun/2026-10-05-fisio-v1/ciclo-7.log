<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Recepção · Atendimento</title><link rel="stylesheet" href="/web/style.css"><script src="/web/recepcao.js" defer></script></head><body><header><h1>Recepção</h1><a href="/">Chat do paciente</a></header><main><form id="login" class="row"><label>Token da recepção<input id="token" type="password" required autocomplete="off"></label><button>Entrar</button></form><p id="aviso" role="status" class="notice"></p><div id="painel" hidden><div class="row"><p class="muted">O token fica apenas nesta aba. Atualize para consultar novas mensagens.</p><button id="atualizar" class="secondary">Atualizar dados</button><button id="sair" class="secondary">Sair</button></div><nav aria-label="Áreas da recepção"><a href="#agenda">Agenda</a><a href="#fila-humano">Fila humana</a><a href="#pacientes">Pacientes</a><a href="#profissionais">Profissionais</a><a href="#servicos">Serviços</a><a href="#faq">FAQ</a><a href="#bloqueios">Bloqueios</a><a href="#saida">Saída</a><a href="#campanhas">Campanhas</a><a href="#raiox">Raio-X</a></nav>
<section id="agenda"><h2>Agenda</h2><form id="filtro-agenda" class="row"><label>De<input name="de" type="date" required></label><label>Até<input name="ate" type="date" required></label><label>Profissional<select name="profissional" data-options="profissionais" data-all="Todos"></select></label><button>Consultar agenda</button></form><div id="lista-agenda"></div><details><summary>Novo agendamento ou lista de espera</summary><form id="novo-agendamento" class="row"><label>Paciente<select name="paciente_id" data-options="pacientes" required></select></label><label>Serviço<select name="servico" data-options="servicos" required></select></label><label>Data<input name="data" type="date" required></label><button type="button" id="buscar-horarios" class="secondary">Buscar horários</button><label>Horário livre<select name="horario" id="horarios"></select></label><button>Agendar</button><button type="button" id="espera" class="secondary">Adicionar à espera</button></form></details></section>
<section id="fila-humano"><h2>Fila humana</h2><div id="lista-fila"></div></section>
<section id="pacientes"><h2>Pacientes</h2><form id="buscar-pacientes" class="row"><label>Nome ou telefone<input name="busca" type="search"></label><button>Buscar</button></form><div id="lista-pacientes"></div><details><summary>Cadastrar paciente</summary><form id="novo-paciente" class="row"><label>Nome<input name="nome" required></label><label>Telefone<input name="telefone" type="tel" required></label><label>E-mail<input name="email" type="email"></label><label>Nascimento<input name="nascimento" type="date"></label><label class="check"><input name="consentimento_marketing" type="checkbox">Consentiu em receber campanhas</label><button>Cadastrar</button></form></details></section>
<section id="profissionais"><h2>Profissionais</h2><div id="lista-profissionais"></div><details><summary>Cadastrar profissional</summary><form id="novo-profissional" class="row"><label>Identificador<input name="id" required></label><label>Nome<input name="nome" required></label><label>Registro profissional<input name="registro"></label><label>Serviços (selecione um ou mais)<select name="servicos" data-options="servicos" multiple required></select></label><button>Cadastrar</button></form></details></section>
<section id="servicos"><h2>Serviços</h2><div id="lista-servicos"></div><details><summary>Cadastrar serviço</summary><form id="novo-servico" class="row"><label>Identificador<input name="id" required></label><label>Nome<input name="nome" required></label><label>Duração em minutos<input name="duracao_min" type="number" min="1" required></label><label>Retorno em dias (opcional)<input name="retorno_dias" type="number" min="1"></label><button>Cadastrar</button></form></details></section>
<section id="faq"><h2>Perguntas frequentes</h2><div id="lista-faq"></div><form id="nova-faq"><label>Perguntas equivalentes (uma por linha)<textarea name="perguntas" required></textarea></label><label>Resposta<textarea name="resposta" required></textarea></label><p><button>Adicionar resposta</button></p></form></section>
<section id="bloqueios"><h2>Bloqueios de agenda</h2><div id="lista-bloqueios"></div><form id="novo-bloqueio" class="row"><label>Profissional<select name="profissional" data-options="profissionais" required></select></label><label>Início<input name="inicio" type="datetime-local" required></label><label>Fim<input name="fim" type="datetime-local" required></label><label>Motivo<input name="motivo" required></label><button>Bloquear período</button></form></section>
<section id="saida"><h2>Caixa de saída</h2><p>Confirmações, retornos, ofertas de espera, campanhas e respostas humanas.</p><button id="tarefas">Rodar lembretes e reenvios</button><div id="lista-saida"></div></section>
<section id="campanhas"><h2>Campanhas</h2><p>Envia apenas para pacientes com consentimento e sem bloqueio de contato. O texto passa pela validação do conselho.</p><form id="campanha"><label>Texto da campanha<textarea name="texto" required></textarea></label><p><button>Validar e enviar campanha</button></p></form></section>
<section id="raiox"><h2>Raio-X do mês</h2><form id="consultar-raiox" class="row"><label>Mês<input name="mes" type="month" required></label><button>Consultar indicadores</button></form><pre id="resultado-raiox"></pre></section></div><dialog id="editor"><h2 id="titulo-editor">Editar cadastro</h2><form id="form-editor"><div id="campos-editor"></div><p class="row"><button>Salvar alterações</button><button type="button" id="fechar-editor" class="secondary">Cancelar</button></p><p id="erro-editor" role="status"></p></form></dialog><noscript>Ative JavaScript para usar a recepção.</noscript></main></body></html>
'use strict';
const $=id=>document.getElementById(id), data={};let token='',editarSalvar=null;
const path=v=>encodeURIComponent(v),formData=f=>Object.fromEntries(new FormData(f)),hoje=()=>{const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;};
function aviso(texto,erro=false){$('aviso').textContent=texto;$('aviso').className='notice'+(erro?' error':'');}
async function api(rota,metodo='GET',corpo){const r=await fetch(rota,{method:metodo,headers:{'X-Token':token,'Content-Type':'application/json'},body:corpo===undefined?undefined:JSON.stringify(corpo)});const d=r.status===204?null:await r.json();if(!r.ok){if(r.status===401)sair();throw Error(d?.erro||d?.violacoes?.join(', ')||`Falha ${r.status}`);}return d;}
async function acao(fn,el){if(el)el.disabled=true;try{await fn();}catch(e){aviso(e.message,true);}finally{if(el)el.disabled=false;}}
function botao(texto,fn){const b=document.createElement('button');b.type='button';b.className='secondary';b.textContent=texto;b.onclick=()=>acao(fn,b);return b;}
function tabela(id,cols,rows,acoes){const alvo=$(id);alvo.replaceChildren();if(!rows.length){alvo.textContent='Nenhum registro encontrado.';return;}const wrap=document.createElement('div');wrap.className='table-wrap';const t=document.createElement('table'),head=t.createTHead().insertRow();for(const [,nome]of cols){const th=document.createElement('th');th.scope='col';th.textContent=nome;head.append(th);}if(acoes){const th=document.createElement('th');th.textContent='Ações';head.append(th);}const body=t.createTBody();for(const r of rows){const row=body.insertRow();for(const [key]of cols){const v=typeof key==='function'?key(r):r[key];row.insertCell().textContent=v===null||v===undefined?'—':String(v);}if(acoes){const cell=row.insertCell();for(const [label,fn]of acoes(r))cell.append(botao(label,fn));}}wrap.append(t);alvo.append(wrap);}
const nome=(tipo,id)=>data[tipo]?.find(v=>String(v.id)===String(id))?.nome||id;
function opcoes(){document.querySelectorAll('[data-options]').forEach(s=>{const valor=s.value;s.replaceChildren();if(s.dataset.all)s.add(new Option(s.dataset.all,''));for(const r of data[s.dataset.options]||[]){if(r.ativo===false||r.telefone===null&&s.dataset.options==='pacientes')continue;s.add(new Option(r.nome,r.id));}if([...s.options].some(o=>o.value===valor))s.value=valor;});}
async function agenda(){const q=new URLSearchParams(formData($('filtro-agenda')));const r=await api('/api/agendamentos?'+q);tabela('lista-agenda',[[r=>r.inicio.replace('T',' '),'Início'],[r=>nome('pacientes',r.paciente_id),'Paciente'],[r=>nome('servicos',r.servico),'Serviço'],[r=>nome('profissionais',r.profissional),'Profissional'],['status','Situação']],r.agendamentos,a=>[['Compareceu',()=>mudarAgenda(a,'presenca',{compareceu:true})],['Faltou',()=>mudarAgenda(a,'presenca',{compareceu:false})],['Remarcar',()=>editor('Remarcar consulta',[['inicio','Novo início','datetime-local',a.inicio]],b=>mudarAgenda(a,'remarcar',b))],['Cancelar',async()=>{if(confirm('Cancelar esta consulta e oferecer a vaga à lista de espera?'))await mudarAgenda(a,'cancelar',{});}]]);}
async function mudarAgenda(a,acao,b){await api(`/api/agendamentos/${a.id}/${acao}`,'POST',b);await agenda();aviso('Agenda atualizada.');}
function editor(titulo,campos,salvar){$('titulo-editor').textContent=titulo;$('campos-editor').replaceChildren();$('erro-editor').textContent='';for(const [key,label,tipo,valor]of campos){const l=document.createElement('label');l.textContent=label;const input=document.createElement(tipo==='textarea'?'textarea':'input');input.name=key;if(tipo!=='textarea')input.type=tipo;if(tipo==='checkbox')input.checked=Boolean(valor);else input.value=valor??'';l.append(input);$('campos-editor').append(l);}editarSalvar=salvar;$('editor').showModal();}
$('fechar-editor').onclick=()=>$('editor').close();$('form-editor').onsubmit=async e=>{e.preventDefault();const b=formData(e.target);e.target.querySelectorAll('input[type=checkbox]').forEach(i=>b[i.name]=i.checked);const submit=e.target.querySelector('button');submit.disabled=true;try{await editarSalvar(b);$('editor').close();}catch(err){$('erro-editor').textContent=err.message;}finally{submit.disabled=false;}};
function baixar(d,nomeArquivo){const url=URL.createObjectURL(new Blob([JSON.stringify(d,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download=nomeArquivo;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}
async function pacientes(busca=''){const r=await api('/api/pacientes?busca='+path(busca));tabela('lista-pacientes',[['nome','Nome'],['telefone','Telefone'],['email','E-mail'],[p=>p.nao_contatar?'Não contatar':p.consentimento_marketing?'Campanhas autorizadas':'Sem campanhas','Preferência']],r.pacientes,p=>[['Editar',()=>editor('Editar paciente',[['nome','Nome','text',p.nome],['telefone','Telefone','tel',p.telefone],['email','E-mail','email',p.email],['nascimento','Nascimento','date',p.nascimento],['consentimento_marketing','Consentimento para campanhas','checkbox',p.consentimento_marketing],['nao_contatar','Não contatar','checkbox',p.nao_contatar]],async b=>{b.nascimento=b.nascimento||null;await api('/api/pacientes/'+p.id,'PUT',b);await carregar();})],['Exportar dados',async()=>baixar(await api(`/api/pacientes/${p.id}/dados`),`paciente-${p.id}.json`)],['Anonimizar',async()=>{if(confirm('Anonimizar este paciente? Dados pessoais serão removidos e consultas futuras canceladas. A ação não pode ser desfeita.')){await api('/api/pacientes/'+p.id,'DELETE');await carregar();aviso('Paciente anonimizado.');}}]]);}
async function catalogo(){tabela('lista-profissionais',[['nome','Nome'],['registro','Registro'],[p=>p.servicos.map(s=>nome('servicos',s)).join(', '),'Serviços'],[p=>p.ativo?'Ativo':'Inativo','Situação']],data.profissionais,p=>[['Editar',()=>editor('Editar profissional',[['nome','Nome','text',p.nome],['registro','Registro','text',p.registro],['servicos','Identificadores dos serviços, separados por vírgula','text',p.servicos.join(', ')],['horarios','Horários em JSON; vazio usa os da clínica','textarea',p.horarios?JSON.stringify(p.horarios,null,2):''],['ativo','Ativo','checkbox',p.ativo]],async b=>{b.servicos=b.servicos.split(',').map(s=>s.trim()).filter(Boolean);b.horarios=b.horarios?JSON.parse(b.horarios):null;await api('/api/profissionais/'+path(p.id),'PUT',b);await carregar();})],['Desativar',()=>desativar('profissionais',p.id)]]);
tabela('lista-servicos',[['nome','Nome'],['duracao_min','Minutos'],['retorno_dias','Retorno (dias)']],data.servicos,s=>[['Editar',()=>editor('Editar serviço',[['nome','Nome','text',s.nome],['duracao_min','Duração em minutos','number',s.duracao_min],['retorno_dias','Retorno em dias (opcional)','number',s.retorno_dias]],async b=>{b.duracao_min=Number(b.duracao_min);b.retorno_dias=b.retorno_dias?Number(b.retorno_dias):null;await api('/api/servicos/'+path(s.id),'PUT',b);await carregar();})],['Desativar',()=>desativar('servicos',s.id)]]);
const faq=await api('/api/faq');tabela('lista-faq',[[r=>r.perguntas.join(' / '),'Perguntas'],['resposta','Resposta']],faq.faq,f=>[['Excluir',async()=>{if(confirm('Excluir esta resposta do FAQ?')){await api('/api/faq/'+path(f.id),'DELETE');await catalogo();}}]]);}
async function desativar(tipo,id){if(confirm('Desativar este cadastro para novos agendamentos?')){await api(`/api/${tipo}/${path(id)}`,'DELETE');await carregar();}}
async function fila(){const r=await api('/api/atendimento-humano');$('lista-fila').replaceChildren();if(!r.fila.length)$('lista-fila').textContent='Nenhum atendimento aguardando a equipe.';for(const f of r.fila){const div=document.createElement('div');div.className='entry';const h=document.createElement('h3');h.textContent=`#${f.id} · ${f.nome||f.telefone} · ${f.prioridade==='alta'?'ALTA PRIORIDADE':'Normal'}`;const p=document.createElement('p');p.textContent=`${f.telefone} — ${f.motivo}`;const form=document.createElement('form'),label=document.createElement('label'),input=document.createElement('textarea');label.textContent='Resposta ao paciente';input.required=true;label.append(input);const b=document.createElement('button');b.textContent='Enviar resposta';form.append(label,b);form.onsubmit=e=>{e.preventDefault();acao(async()=>{await api(`/api/atendimento-humano/${f.id}/responder`,'POST',{texto:input.value});input.value='';aviso('Resposta registrada. Confira a entrega na caixa de saída.');await saida();},b);};div.append(h,p,form,botao('Encerrar atendimento',async()=>{await api(`/api/atendimento-humano/${f.id}/encerrar`,'POST',{});await fila();}));$('lista-fila').append(div);}}
async function saida(){const r=await api('/api/saida');tabela('lista-saida',[['tipo','Tipo'],['telefone','Telefone'],['texto','Mensagem'],['status','Entrega']],r.mensagens.slice().reverse());}
async function bloqueios(){const r=await api('/api/bloqueios');tabela('lista-bloqueios',[[b=>nome('profissionais',b.profissional),'Profissional'],['inicio','Início'],['fim','Fim'],['motivo','Motivo']],r.bloqueios,b=>[['Liberar',async()=>{if(confirm('Liberar este período?')){await api('/api/bloqueios/'+b.id,'DELETE');await bloqueios();}}]]);}
async function carregar(){for(const tipo of ['pacientes','servicos','profissionais'])data[tipo]=(await api('/api/'+tipo))[tipo];opcoes();await agenda();await pacientes();await catalogo();await fila();await saida();await bloqueios();}
function sair(){token='';$('token').value='';$('painel').hidden=true;$('login').hidden=false;for(const key of Object.keys(data))delete data[key];document.querySelectorAll('[id^="lista-"]').forEach(e=>e.replaceChildren());$('resultado-raiox').textContent='';$('editor').close();document.querySelectorAll('#painel form').forEach(f=>f.reset());$('campos-editor').replaceChildren();}
$('login').onsubmit=e=>{e.preventDefault();acao(async()=>{token=$('token').value;await carregar();$('token').value='';$('login').hidden=true;$('painel').hidden=false;aviso('Recepção conectada.');},e.target.querySelector('button'));};$('sair').onclick=()=>{sair();aviso('Sessão encerrada nesta aba.');};$('atualizar').onclick=e=>acao(async()=>{await carregar();aviso('Dados atualizados.');},e.target);
function formulario(id,fn){$(id).onsubmit=e=>{e.preventDefault();acao(()=>fn(formData(e.target),e.target),e.target.querySelector('button'));};}
formulario('filtro-agenda',agenda);formulario('buscar-pacientes',b=>pacientes(b.busca));
formulario('novo-paciente',async(b,f)=>{b.nascimento=b.nascimento||null;b.consentimento_marketing=f.elements.consentimento_marketing.checked;await api('/api/pacientes','POST',b);f.reset();await carregar();aviso('Paciente cadastrado.');});
formulario('novo-profissional',async(b,f)=>{b.servicos=[...f.elements.servicos.selectedOptions].map(o=>o.value);await api('/api/profissionais','POST',b);f.reset();await carregar();aviso('Profissional cadastrado.');});
formulario('novo-servico',async(b,f)=>{b.duracao_min=Number(b.duracao_min);b.retorno_dias=b.retorno_dias?Number(b.retorno_dias):null;await api('/api/servicos','POST',b);f.reset();await carregar();aviso('Serviço cadastrado.');});
formulario('nova-faq',async(b,f)=>{b.perguntas=b.perguntas.split('\n').map(s=>s.trim()).filter(Boolean);await api('/api/faq','POST',b);f.reset();await catalogo();aviso('Resposta adicionada ao FAQ.');});
formulario('novo-bloqueio',async(b,f)=>{const r=await api('/api/bloqueios','POST',b);f.reset();await bloqueios();aviso('Período bloqueado.'+(r.conflitos.length?' Consultas em conflito: '+r.conflitos.join(', ')+'. Revise a agenda; nenhuma foi cancelada.':''));});
$('buscar-horarios').onclick=e=>acao(async()=>{const b=formData($('novo-agendamento'));if(!b.data||!b.servico)throw Error('Escolha o serviço e a data.');const r=await api('/api/horarios?'+new URLSearchParams({servico:b.servico,data:b.data}));$('horarios').replaceChildren();for(const h of r.horarios)$('horarios').add(new Option(h.inicio.replace('T',' ')+' · '+nome('profissionais',h.profissional),JSON.stringify(h)));aviso(r.horarios.length?'Escolha o horário e clique em Agendar.':'Não há horários livres. Você pode adicionar o paciente à espera.');},e.target);
for(const name of ['data','servico'])$('novo-agendamento').elements[name].onchange=()=>$('horarios').replaceChildren();
formulario('novo-agendamento',async b=>{if(!b.horario)throw Error('Busque e escolha um horário livre.');await api('/api/agendamentos','POST',{paciente_id:Number(b.paciente_id),servico:b.servico,...JSON.parse(b.horario)});$('horarios').replaceChildren();await agenda();aviso('Consulta agendada. Confira o período consultado na agenda.');});
$('espera').onclick=e=>acao(async()=>{const b=formData($('novo-agendamento'));if(!b.data||!b.paciente_id||!b.servico)throw Error('Escolha paciente, serviço e data.');await api('/api/espera','POST',{paciente_id:Number(b.paciente_id),servico:b.servico,data:b.data});aviso('Paciente adicionado à lista de espera.');},e.target);
$('tarefas').onclick=e=>acao(async()=>{const r=await api('/api/tarefas/rodar','POST',{});await saida();aviso(`${r.enviadas} notificações criadas; ${r.reenviadas||0} reenvios entregues.`);},e.target);
formulario('campanha',async b=>{if(!confirm('Enviar esta campanha aos pacientes que autorizaram contato?'))return;const r=await api('/api/campanhas','POST',b);await saida();aviso(`${r.enviadas} mensagens de campanha registradas.`);});
