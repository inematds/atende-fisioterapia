"""CLI e transporte HTTP; cada requisição de domínio é uma transação."""
import argparse
import hmac
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import re
import sys
from urllib.parse import parse_qs, urlsplit

from .core import Clinica, Erro, ROOT
from . import conversa, gestao, cadastros, backup, integracoes, planos, exercicios


def rotear(c, metodo, rota, q, b):
    m = re.fullmatch(r'/api/exercicios(?:/([^/]+))?', rota)
    if m:
        ident = m[1]
        if metodo == 'GET' and ident is None:
            return 200, {'exercicios': exercicios.listar(c)}
        if metodo == 'POST' and ident is None:
            return 201, exercicios.salvar(c, b)
        if metodo == 'PUT' and ident is not None:
            return 200, exercicios.salvar(c, b, ident)
        if metodo == 'DELETE' and ident is not None:
            exercicios.salvar(c, {'ativo': False}, ident)
            return 200, {'ativo': False}
    if rota == '/api/planos':
        if metodo == 'POST':
            return 201, planos.criar(c, b)
        if metodo == 'GET':
            return 200, {'planos': planos.listar(c, q.get('paciente_id'))}
    m = re.fullmatch(r'/api/planos/(\d+)(/encerrar)?', rota)
    if m:
        if metodo == 'GET' and not m[2]:
            return 200, planos.obter(c, int(m[1]))
        if metodo == 'POST' and m[2]:
            return 200, planos.encerrar(c, int(m[1]), b.get('motivo'))
    if metodo == 'GET' and rota == '/api/alertas':
        return 200, {'alertas': planos.listar_alertas(c)}
    m = re.fullmatch(r'/api/alertas/(\d+)/resolver', rota)
    if metodo == 'POST' and m:
        return 200, planos.resolver(c, int(m[1]))
    if metodo == 'POST' and rota.startswith('/webhook/evolution/'):
        integracoes.evolution(c, b)
        return 200, {'ok': True}
    if metodo == 'POST' and rota == '/webhook/telegram':
        integracoes.receber_telegram(c, b)
        return 200, {'ok': True}
    m = re.fullmatch(r'/api/atendimento-humano/(\d+)/(responder|encerrar)', rota)
    if metodo == 'POST' and m:
        return 200, integracoes.humano(c, int(m[1]), m[2], b.get('texto'))
    if metodo == 'GET' and rota == '/api/pacientes':
        return 200, {'pacientes': cadastros.pacientes(c, q.get('busca', ''))}
    m = re.fullmatch(r'/api/pacientes/(\d+)', rota)
    if metodo == 'PUT' and m:
        return 200, cadastros.editar_paciente(c, int(m[1]), b)
    m = re.fullmatch(r'/api/(profissionais|servicos|faq)(?:/([^/]+))?', rota)
    if m:
        tipo, ident = m.groups()
        if metodo == 'GET' and ident is None and tipo != 'servicos':
            return 200, {tipo: c.catalogo(tipo)}
        if metodo == 'POST' and ident is None:
            item = cadastros.salvar_catalogo(c, tipo, b)
            return 201, {'id': item['id']} if tipo == 'faq' else item
        if metodo == 'PUT' and ident is not None and tipo != 'faq':
            return 200, cadastros.salvar_catalogo(c, tipo, b, ident)
        if metodo == 'DELETE' and ident is not None:
            if tipo == 'faq':
                c.db.execute('DELETE FROM catalogo WHERE tipo=? AND id=?', (tipo, ident))
                return 204, None
            cadastros.salvar_catalogo(c, tipo, {'ativo': False}, ident)
            return 200, {'ativo': False}
    if rota == '/api/bloqueios':
        if metodo == 'POST':
            return 201, cadastros.bloquear(c, b)
        if metodo == 'GET':
            return 200, {'bloqueios': [dict(r) for r in c.db.execute(
                'SELECT * FROM bloqueios WHERE (? IS NULL OR profissional=?) ORDER BY id',
                (q.get('profissional'), q.get('profissional')))]}
    m = re.fullmatch(r'/api/bloqueios/(\d+)', rota)
    if metodo == 'DELETE' and m:
        c.db.execute('DELETE FROM bloqueios WHERE id=?', (int(m[1]),))
        return 204, None
    if metodo == 'GET' and rota == '/api/saude':
        return 200, {'ok': True, 'versao': (ROOT / 'VERSION').read_text().strip()}
    if metodo == 'GET' and rota == '/api/servicos':
        return 200, {'servicos': [s for s in c.catalogo('servicos') if s['ativo']]}
    if metodo == 'GET' and rota == '/api/horarios':
        return 200, {'horarios': c.horarios(q['servico'], q['data'], q.get('profissional'))}
    if metodo == 'POST' and rota == '/api/mensagens':
        return 200, {'respostas': conversa.conversar(c, b['telefone'], b['texto'])}
    if metodo == 'GET' and rota == '/api/atendimento-humano':
        return 200, {'fila': conversa.fila(c)}
    if metodo == 'GET' and rota == '/api/saida':
        return 200, {'mensagens': [dict(r) for r in c.db.execute('SELECT * FROM saida ORDER BY id')]}
    if metodo == 'POST' and rota == '/api/tarefas/rodar':
        return 200, conversa.rodar(c, b.get('agora'))
    if metodo == 'POST' and rota == '/api/espera':
        c.paciente(b['paciente_id'])
        c.servico(b['servico'])
        from datetime import datetime
        datetime.strptime(b['data'], '%Y-%m-%d')
        ident = c.db.execute('INSERT INTO espera(paciente_id,servico,data) VALUES (?,?,?)',
                             (b['paciente_id'], b['servico'], b['data'])).lastrowid
        return 201, {'id': ident}
    m = re.fullmatch(r'/api/pacientes/(\d+)/dados', rota)
    if metodo == 'GET' and m:
        return 200, conversa.dados_paciente(c, int(m[1]))
    if metodo == 'POST' and rota == '/api/campanhas':
        return gestao.campanhas(c, b['texto'])
    if metodo == 'GET' and rota == '/api/raiox':
        return 200, gestao.raiox(c, q['mes'])
    m = re.fullmatch(r'/api/pacientes/(\d+)', rota)
    if metodo == 'DELETE' and m:
        gestao.remover_paciente(c, int(m[1]))
        return 204, None
    if metodo == 'POST' and rota == '/api/pacientes':
        return c.criar_paciente(b)
    if metodo == 'POST' and rota == '/api/agendamentos':
        return 201, c.agendar(b)
    if metodo == 'GET' and rota == '/api/agendamentos':
        return 200, {'agendamentos': c.listar_agenda(q)}
    m = re.fullmatch(r'/api/agendamentos/(\d+)/(cancelar|remarcar|presenca)', rota)
    if metodo == 'POST' and m:
        ident, acao = int(m[1]), m[2]
        a = c.agendamento(ident)
        if acao == 'remarcar':
            return 200, c.agendar({**a, 'inicio': b['inicio']}, ident)
        if acao == 'presenca' and not isinstance(b.get('compareceu'), bool):
            raise Erro(400, 'compareceu deve ser booleano')
        status = 'cancelado' if acao == 'cancelar' else ('realizado' if b['compareceu'] else 'falta')
        if acao == 'cancelar':
            conversa.cancelar(c, ident)
        else:
            conversa.presenca(c, ident, b['compareceu'])
        return 200, {'status': status}
    raise Erro(404, 'Rota inexistente')


def main():
    parser = argparse.ArgumentParser(description='Atendimento da clínica')
    sub = parser.add_subparsers(dest='comando', required=True)
    serve = sub.add_parser('serve')
    serve.add_argument('--porta', type=int, default=8080)
    serve.add_argument('--host', default='127.0.0.1')
    serve.add_argument('--dados', required=True)
    raiox = sub.add_parser('raiox')
    raiox.add_argument('--dados', required=True)
    raiox.add_argument('--mes', required=True)
    raiox.add_argument('--acompanhamento', required=True)
    for comando, arquivo in (('backup', '--saida'), ('restaurar', '--entrada')):
        p = sub.add_parser(comando)
        p.add_argument('--dados', required=True)
        p.add_argument(arquivo, required=True)
    args = parser.parse_args()
    if args.comando in ('backup', 'restaurar'):
        try:
            if args.comando == 'backup':
                backup.copiar(args.dados, args.saida)
            else:
                backup.restaurar(args.dados, args.entrada)
        except Exception as e:
            parser.exit(1, f'Falha no {args.comando}: {e}\n')
        return
    if args.comando == 'raiox':
        clinica = Clinica(args.dados)
        try:
            conversa.iniciar(clinica)
            gestao.exportar(clinica, args.mes, args.acompanhamento)
        finally:
            clinica.db.close()
        return
    clinica = Clinica(args.dados)
    conversa.iniciar(clinica)

    class Handler(BaseHTTPRequestHandler):
        def processar(self):
            url = urlsplit(self.path)
            arquivos = {'/': ('index.html', 'text/html'), '/recepcao': ('recepcao.html', 'text/html'),
                        '/web/exercicio.css': ('exercicio.css', 'text/css'),
                        '/web/style.css': ('style.css', 'text/css'), '/web/chat.js': ('chat.js', 'text/javascript'),
                        '/web/recepcao.js': ('recepcao.js', 'text/javascript')}
            if self.command == 'GET' and url.path in arquivos:
                nome, tipo = arquivos[url.path]
                conteudo = (ROOT / 'web' / nome).read_bytes()
                self.send_response(200)
                self.send_header('Content-Type', tipo + '; charset=utf-8')
                self.send_header('Content-Length', str(len(conteudo)))
                self.send_header('Cache-Control', 'no-store')
                self.send_header('X-Content-Type-Options', 'nosniff')
                self.send_header('Content-Security-Policy', "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'")
                self.end_headers()
                self.wfile.write(conteudo)
                return
            publico = (self.command == 'GET' and url.path in ('/', '/recepcao', '/api/saude', '/api/servicos', '/api/exercicios', '/api/horarios')) or (self.command == 'POST' and url.path == '/api/mensagens')
            try:
                if self.command == 'GET' and url.path.startswith('/exercicios/'):
                    with clinica.lock:
                        tipo, conteudo = exercicios.recurso(clinica, url.path)
                    self.send_response(200)
                    self.send_header('Content-Type', tipo)
                    self.send_header('Content-Length', str(len(conteudo)))
                    self.send_header('X-Content-Type-Options', 'nosniff')
                    self.send_header('Cache-Control', 'no-store')
                    self.send_header('Content-Security-Policy', "default-src 'none'; img-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'")
                    self.end_headers()
                    self.wfile.write(conteudo)
                    return
                if self.command == 'POST' and integracoes.autorizar(url.path, self.headers):
                    publico = True
                if not publico and not hmac.compare_digest(self.headers.get('X-Token', '').encode(), str(clinica.cfg['token']).encode()):
                    raise Erro(401, 'Token inválido')
                tamanho = int(self.headers.get('Content-Length', '0'))
                if tamanho < 0 or tamanho > 1048576:
                    raise Erro(413, 'Corpo muito grande')
                b = json.loads(self.rfile.read(tamanho)) if tamanho else {}
                if not isinstance(b, dict):
                    raise Erro(400, 'Objeto JSON esperado')
                q = {k: v[-1] for k, v in parse_qs(url.query).items()}
                with clinica.lock, clinica.db:
                    status, resposta = rotear(clinica, self.command, url.path, q, b)
            except Erro as e:
                status, resposta = e.status, {'erro': e.mensagem}
            except (ValueError, KeyError, TypeError):
                status, resposta = 400, {'erro': 'Pedido inválido'}
            except Exception as e:
                print(f'Erro interno: {type(e).__name__}: {e}', file=sys.stderr)
                status, resposta = 500, {'erro': 'Erro interno'}
            conteudo = b'' if status == 204 else json.dumps(resposta, ensure_ascii=False).encode('utf-8')
            self.send_response(status)
            self.send_header('Content-Type', 'application/json; charset=utf-8')
            self.send_header('Content-Length', str(len(conteudo)))
            self.end_headers()
            self.wfile.write(conteudo)

        do_GET = do_POST = do_PUT = do_DELETE = processar

        def log_message(self, *args):
            pass

    ThreadingHTTPServer.request_queue_size = 64
    servidor = ThreadingHTTPServer((args.host, args.porta), Handler)
    print(f'PORTA={servidor.server_port}', flush=True)
    try:
        servidor.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        servidor.server_close()
        clinica.db.close()
"""Estado transacional e regras de agenda da clínica."""
import json
import os
from pathlib import Path
import re
import shutil
import sqlite3
import threading
from datetime import datetime, timedelta

ROOT = Path(__file__).resolve().parent.parent


class Erro(Exception):
    def __init__(self, status, mensagem):
        self.status, self.mensagem = status, mensagem


def agora():
    return datetime.fromisoformat(os.environ['ATENDE_AGORA']) if os.environ.get('ATENDE_AGORA') else datetime.now()


def telefone(valor):
    if not isinstance(valor, str) or re.search(r'[^\d+()\s-]', valor):
        raise Erro(400, 'Telefone inválido')
    digitos = re.sub(r'\D', '', valor)
    if len(digitos) in (12, 13) and digitos.startswith('55'):
        digitos = digitos[2:]
    if len(digitos) not in (10, 11):
        raise Erro(400, 'Telefone inválido')
    return '+55' + digitos


class Clinica:
    def __init__(self, pasta):
        self.pasta = Path(pasta)
        self.pasta.mkdir(parents=True, exist_ok=True)
        config = self.pasta / 'clinica.json'
        if not config.exists():
            shutil.copyfile(ROOT / 'exemplos/clinica.json', config)
        self.cfg = json.loads(config.read_text(encoding='utf-8'))
        self.cfg = {**dict(abandono_faltas=2, reavaliacao_sessoes=2, reavaliacao_dias=30, dor_alerta=7, lembrete_hora_padrao='19:00'), **self.cfg}
        self.lock = threading.RLock()
        self.db = sqlite3.connect(self.pasta / 'estado.sqlite3', check_same_thread=False)
        self.db.row_factory = sqlite3.Row
        self.db.execute('PRAGMA foreign_keys=ON')
        self.db.executescript('''
            CREATE TABLE IF NOT EXISTS catalogo (tipo TEXT, id TEXT, dados TEXT, PRIMARY KEY(tipo,id));
            CREATE TABLE IF NOT EXISTS meta (chave TEXT PRIMARY KEY, valor TEXT);
            CREATE TABLE IF NOT EXISTS pacientes (
                id INTEGER PRIMARY KEY, nome TEXT NOT NULL, telefone TEXT UNIQUE,
                email TEXT, nascimento TEXT, consentimento_marketing INTEGER NOT NULL DEFAULT 0,
                nao_contatar INTEGER NOT NULL DEFAULT 0);
            CREATE TABLE IF NOT EXISTS agendamentos (
                id INTEGER PRIMARY KEY, paciente_id INTEGER NOT NULL REFERENCES pacientes(id),
                servico TEXT NOT NULL, profissional TEXT NOT NULL, inicio TEXT NOT NULL,
                fim TEXT NOT NULL, status TEXT NOT NULL, plano_id INTEGER);
            CREATE INDEX IF NOT EXISTS agenda_profissional ON agendamentos(profissional,inicio,fim);
            CREATE TABLE IF NOT EXISTS bloqueios (
                id INTEGER PRIMARY KEY, profissional TEXT NOT NULL,
                inicio TEXT NOT NULL, fim TEXT NOT NULL, motivo TEXT NOT NULL);
        ''')
        from . import planos
        planos.iniciar(self)
        with self.db:
            if not self.db.execute("SELECT 1 FROM meta WHERE chave='semeado'").fetchone():
                for tipo in ('servicos', 'profissionais', 'faq', 'exercicios'):
                    for item in self.cfg.get(tipo, []):
                        item = dict(item)
                        if tipo != 'faq':
                            item.setdefault('ativo', True)
                        if tipo == 'profissionais':
                            item.setdefault('registro', None)
                            item.setdefault('horarios', None)
                        self.db.execute('INSERT INTO catalogo VALUES (?,?,?)', (tipo, item['id'], json.dumps(item)))
                self.db.execute("INSERT INTO meta VALUES ('semeado','1')")

    def catalogo(self, tipo):
        return [json.loads(r[0]) for r in self.db.execute('SELECT dados FROM catalogo WHERE tipo=? ORDER BY rowid', (tipo,))]

    def servico(self, ident):
        for s in self.catalogo('servicos'):
            if s['id'] == ident:
                return s
        raise Erro(404, 'Serviço inexistente')

    def paciente(self, ident):
        r = self.db.execute('SELECT * FROM pacientes WHERE id=?', (ident,)).fetchone()
        if not r:
            raise Erro(404, 'Paciente inexistente')
        p = dict(r)
        for k in ('consentimento_marketing', 'nao_contatar'):
            p[k] = bool(p[k])
        return p

    def criar_paciente(self, b):
        from .cadastros import validar_paciente
        validar_paciente(b)
        tel = telefone(b.get('telefone'))
        r = self.db.execute('SELECT id FROM pacientes WHERE telefone=?', (tel,)).fetchone()
        if r:
            return 200, {'id': r[0]}
        if not isinstance(b.get('nome'), str) or not b['nome'].strip():
            raise Erro(400, 'Nome obrigatório')
        c = self.db.execute('INSERT INTO pacientes(nome,telefone,email,nascimento,consentimento_marketing) VALUES (?,?,?,?,?)',
                            (b['nome'], tel, b.get('email'), b.get('nascimento'), bool(b.get('consentimento_marketing', False))))
        ident = c.lastrowid
        # A preferência de contato pode anteceder o cadastro pela recepção.
        if self.db.execute("SELECT 1 FROM sqlite_master WHERE name='sessoes'").fetchone():
            sessao = self.db.execute('SELECT dados FROM sessoes WHERE telefone=?', (tel,)).fetchone()
            if sessao and json.loads(sessao[0]).get('nao_contatar'):
                self.db.execute('UPDATE pacientes SET nao_contatar=1 WHERE id=?', (ident,))
            self.db.execute('UPDATE historico SET paciente_id=? WHERE telefone=? AND paciente_id IS NULL', (ident, tel))
        return 201, {'id': ident}

    def candidatos(self, servico, data, profissional=None):
        s = self.servico(servico)
        dia = datetime.strptime(data, '%Y-%m-%d')
        if not s['ativo'] or data in self.cfg.get('feriados', []):
            return []
        resultado = []
        duracao = timedelta(minutes=s['duracao_min'])
        passo = timedelta(minutes=self.cfg['passo_min'])
        if passo.total_seconds() <= 0 or duracao.total_seconds() <= 0:
            raise Erro(422, 'Duração e passo devem ser positivos')
        limite = agora() + timedelta(hours=self.cfg['antecedencia_min_horas'])
        for p in self.catalogo('profissionais'):
            if not p['ativo'] or servico not in p['servicos'] or (profissional and profissional != p['id']):
                continue
            grade = p.get('horarios') if p.get('horarios') is not None else self.cfg['horarios']
            for ini, fim in grade.get(('seg', 'ter', 'qua', 'qui', 'sex', 'sab', 'dom')[dia.weekday()], []):
                t = datetime.fromisoformat(data + 'T' + ini)
                final = datetime.fromisoformat(data + 'T' + fim)
                while t + duracao <= final:
                    bloqueado = self.db.execute('SELECT 1 FROM bloqueios WHERE profissional=? AND inicio < ? AND fim > ?',
                        (p['id'], (t + duracao).isoformat(timespec='minutes'), t.isoformat(timespec='minutes'))).fetchone()
                    if t >= limite and not bloqueado:
                        resultado.append({'inicio': t.isoformat(timespec='minutes'), 'profissional': p['id']})
                    t += passo
        return sorted(resultado, key=lambda h: (h['inicio'], h['profissional']))

    def livre(self, profissional, inicio, fim, ignorar=None):
        return not self.db.execute('''SELECT 1 FROM agendamentos WHERE profissional=?
            AND status IN ('agendado','confirmado','realizado','falta') AND inicio < ? AND fim > ?
            AND (? IS NULL OR id != ?) LIMIT 1''', (profissional, fim, inicio, ignorar, ignorar)).fetchone()

    def horarios(self, servico, data, profissional=None):
        duracao = self.servico(servico)['duracao_min']
        return [h for h in self.candidatos(servico, data, profissional) if self.livre(h['profissional'], h['inicio'],
                (datetime.fromisoformat(h['inicio']) + timedelta(minutes=duracao)).isoformat(timespec='minutes'))]

    def agendar(self, b, ident=None):
        self.paciente(b['paciente_id'])
        s = self.servico(b['servico'])
        from . import planos
        plano_id = planos.vinculo(self, b)
        inicio = b['inicio']
        try:
            datetime.strptime(inicio, '%Y-%m-%dT%H:%M')
        except (ValueError, TypeError):
            raise Erro(422, 'Horário inválido')
        candidatos = [h for h in self.candidatos(s['id'], inicio[:10], b.get('profissional')) if h['inicio'] == inicio]
        if not candidatos:
            raise Erro(422, 'Horário inválido')
        fim = (datetime.fromisoformat(inicio) + timedelta(minutes=s['duracao_min'])).isoformat(timespec='minutes')
        for h in candidatos:
            if self.livre(h['profissional'], inicio, fim, ident):
                valores = (b['paciente_id'], s['id'], h['profissional'], inicio, fim, 'agendado', plano_id)
                if ident is None:
                    ident = self.db.execute('INSERT INTO agendamentos(paciente_id,servico,profissional,inicio,fim,status,plano_id) VALUES (?,?,?,?,?,?,?)', valores).lastrowid
                else:
                    self.db.execute('UPDATE agendamentos SET paciente_id=?,servico=?,profissional=?,inicio=?,fim=?,status=?,plano_id=? WHERE id=?', (*valores, ident))
                return self.agendamento(ident)
        raise Erro(409, 'Horário ocupado')

    def agendamento(self, ident):
        r = self.db.execute('SELECT a.*,p.telefone FROM agendamentos a JOIN pacientes p ON p.id=a.paciente_id WHERE a.id=?', (ident,)).fetchone()
        if not r:
            raise Erro(404, 'Agendamento inexistente')
        return dict(r)

    def listar_agenda(self, q):
        de = q.get('data', q.get('de', '0001-01-01'))
        ate = q.get('data', q.get('ate', '9999-12-31'))
        return [dict(r) for r in self.db.execute('''SELECT a.*,p.telefone FROM agendamentos a JOIN pacientes p ON p.id=a.paciente_id
            WHERE substr(inicio,1,10) BETWEEN ? AND ? AND (? IS NULL OR profissional=?) ORDER BY inicio,a.id''',
            (de, ate, q.get('profissional'), q.get('profissional')))]

