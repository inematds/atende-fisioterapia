"""Campanhas, anonimização e indicadores, sem dependências de transporte."""
import calendar
from datetime import datetime, timedelta
import json
import os
from pathlib import Path
import re
import tempfile
import unicodedata

from .core import Erro
from . import conversa


def campanhas(c, texto):
    if not isinstance(texto, str) or not texto.strip():
        raise Erro(400, 'Texto obrigatório')
    normal = ''.join(x for x in unicodedata.normalize('NFD', texto.lower())
                     if unicodedata.category(x) != 'Mn')
    regras = (
        ('promessa_resultado', ('cfm', 'cfo', 'coffito', 'estetica'),
         r'garantido|garantia de resultado|100%'),
        ('melhor_profissional', ('cfm', 'cfo', 'coffito'),
         r'melhor medico|melhor dentista|melhor fisioterapeuta|melhor clinica'),
        ('sorteio_brinde', ('cfm', 'cfo'), r'sorteio|brinde|premio|premiacao'),
        ('antes_depois', ('cfm', 'cfo'), r'antes e depois'),
        ('consorcio', ('cfm',), r'consorcio'),
        ('preco', ('cfo', 'coffito'), r'r\$|reais'),
        ('parcelamento', ('cfo',), r'parcela|sem juros|\d+x\b'),
        ('gratuito', ('cfo', 'coffito'), r'gratis|gratuito|gratuita'),
        ('depoimento', ('coffito',), r'depoimento|carta de agradecimento|agradecimento de paciente'),
        ('promocao', ('coffito',), r'promocao|desconto|oferta'),
    )
    violacoes = [codigo for codigo, conselhos, padrao in regras
                if c.cfg['conselho'] in conselhos and re.search(padrao, normal)]
    if violacoes:
        return 422, {'violacoes': violacoes}
    pacientes = c.db.execute('SELECT id FROM pacientes WHERE consentimento_marketing=1 AND nao_contatar=0').fetchall()
    return 200, {'enviadas': sum(conversa.enviar(c, p['id'], 'campanha', texto) for p in pacientes)}


def remover_paciente(c, ident):
    p = c.paciente(ident)
    # Desvincula o telefone antes de liberar vagas: ele não pode receber oferta.
    c.db.execute('''UPDATE pacientes SET nome='removido', telefone=NULL, email=NULL,
        nascimento=NULL, consentimento_marketing=0, nao_contatar=1 WHERE id=?''', (ident,))
    c.db.execute("UPDATE espera SET status='cancelado' WHERE paciente_id=?", (ident,))
    c.db.execute("UPDATE planos SET status='encerrado' WHERE paciente_id=? AND status='ativo'", (ident,))
    c.db.execute('UPDATE retornos SET avisado=1 WHERE paciente_id=?', (ident,))
    for a in c.db.execute("SELECT id FROM agendamentos WHERE paciente_id=? AND status IN ('agendado','confirmado')", (ident,)).fetchall():
        conversa.cancelar(c, a['id'])
    c.db.execute("UPDATE historico SET texto='',telefone=NULL WHERE paciente_id=? OR telefone=?", (ident, p['telefone']))
    c.db.execute("UPDATE saida SET texto='',telefone=NULL,oferta=NULL,respondida=1,status='simulado' WHERE paciente_id=? OR telefone=?", (ident, p['telefone']))
    if p['telefone']:
        c.db.execute('DELETE FROM sessoes WHERE telefone=?', (p['telefone'],))
        c.db.execute("UPDATE humanos SET telefone=NULL,motivo='',status='encerrado' WHERE telefone=?", (p['telefone'],))


def raiox(c, mes):
    if not isinstance(mes, str) or not re.fullmatch(r'\d{4}-\d{2}', mes):
        raise Erro(400, 'Mês inválido')
    inicio = datetime.strptime(mes, '%Y-%m')
    dias = calendar.monthrange(inicio.year, inicio.month)[1]
    registros = [dict(r) for r in c.db.execute('SELECT * FROM agendamentos WHERE substr(inicio,1,7)=?', (mes,))]
    realizados = sum(a['status'] == 'realizado' for a in registros)
    faltas = sum(a['status'] == 'falta' for a in registros)
    ocupados = sum((datetime.fromisoformat(a['fim']) - datetime.fromisoformat(a['inicio'])).total_seconds() / 60
                   for a in registros if a['status'] in ('agendado', 'confirmado', 'realizado', 'falta'))
    disponiveis = 0
    for dia in range(dias):
        data = inicio + timedelta(days=dia)
        if data.date().isoformat() in c.cfg.get('feriados', []):
            continue
        semana = ('seg', 'ter', 'qua', 'qui', 'sex', 'sab', 'dom')[data.weekday()]
        for p in c.catalogo('profissionais'):
            if not p['ativo']:
                continue
            grade = p.get('horarios') if p.get('horarios') is not None else c.cfg['horarios']
            for ini, fim in grade.get(semana, []):
                disponiveis += (datetime.strptime(fim, '%H:%M') - datetime.strptime(ini, '%H:%M')).total_seconds() / 60
    novos = c.db.execute('''SELECT COUNT(*) FROM (SELECT paciente_id, MIN(inicio) AS primeiro
        FROM agendamentos WHERE status='realizado' GROUP BY paciente_id) WHERE substr(primeiro,1,7)=?''', (mes,)).fetchone()[0]
    retornos = c.db.execute('SELECT * FROM retornos WHERE substr(data,1,7)=?', (mes,)).fetchall()
    cumpridos = 0
    for r in retornos:
        data = datetime.fromisoformat(r['data'])
        de, ate = ((data + timedelta(days=n)).date().isoformat() for n in (-30, 30))
        cumpridos += bool(c.db.execute('''SELECT 1 FROM agendamentos WHERE paciente_id=? AND servico=?
            AND status='realizado' AND substr(inicio,1,10) BETWEEN ? AND ? LIMIT 1''',
            (r['paciente_id'], r['servico'], de, ate)).fetchone())
    def percentual(n, total):
        return round(n / total * 100, 1) if total else 0.0
    distintos = len({a['paciente_id'] for a in registros if a['status'] == 'realizado'})
    orcamentos = c.db.execute('SELECT id FROM planos WHERE substr(criado_em,1,7)=?', (mes,)).fetchall()
    aprovados = sum(bool(c.db.execute("SELECT 1 FROM agendamentos WHERE plano_id=? AND status='realizado' LIMIT 1", (p['id'],)).fetchone()) for p in orcamentos)
    return {'pacote': 'clinica', 'mes': mes, 'valores': {
        'atendimentos_mes': realizados, 'falta_pct': percentual(faltas, realizados + faltas),
        'ocupacao_pct': percentual(ocupados, disponiveis), 'clientes_novos_mes': novos,
        'retorno_atual_pct': percentual(cumpridos, len(retornos)),
        'atendimentos_mes_recorrente': round(realizados / distintos, 1) if distintos else 0.0,
        'orcamentos_mes': len(orcamentos), 'aprovacao_atual_pct': percentual(aprovados, len(orcamentos)),
    }}


def exportar(c, mes, arquivo):
    valores = raiox(c, mes)['valores']
    caminho = Path(arquivo)
    acompanhamento = json.loads(caminho.read_text(encoding='utf-8'))
    meses = acompanhamento.get('meses', [])
    anteriores = sorted((m for m in meses if m['mes'] < mes), key=lambda m: m['mes'])
    anterior = anteriores[-1]['valores'] if anteriores else acompanhamento['base']['valores']
    novo = {'mes': mes, 'valores': {**anterior, **valores}, 'obs': 'atende-fisioterapia'}
    acompanhamento['meses'] = sorted([m for m in meses if m['mes'] != mes] + [novo], key=lambda m: m['mes'])
    # Substituição atômica evita JSON parcial em caso de interrupção.
    nome = None
    try:
        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', dir=caminho.parent, delete=False) as f:
            nome = f.name
            json.dump(acompanhamento, f, ensure_ascii=False, indent=2)
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        os.replace(nome, caminho)
    finally:
        if nome and os.path.exists(nome):
            os.unlink(nome)
Telefone: aceita com ou sem `+55`, espaços, parênteses e hífen; normaliza para `+55DDNNNNNNNNN` (DDD + 8 ou 9 dígitos; 10 ou 11 dígitos sem o 55, 12 ou 13 com ele). Fora disso → inválido. Todas as respostas usam o telefone normalizado.

**Envio síncrono:** `tarefas/rodar`, `campanhas`, `POST .../prescricao`, `.../responder` e `/responder` do Telegram só devolvem a resposta HTTP depois de tentar os envios (o `status` da mensagem já está definido ao responder). Respostas ao webhook da Evolution e avisos ao Telegram podem ser assíncronos.

## 6. Conversa (`POST /api/mensagens`)

O texto é normalizado (minúsculas, sem acento, pontuação trocada por espaço) antes de decidir. "Contém X" = X aparece como **sequência de palavras inteiras** no texto normalizado (`fiz` não casa `fizemos`; `dor 7` exige as duas palavras seguidas, então `minha dor hoje e 7` não casa), **exceto** na regra 1, que usa substring como no atende-clinica. Ordem de decisão (a primeira que casa decide):

1. **Emergência** — o texto contém (substring) um destes: `dor no peito`, `falta de ar`, `desmaio`, `desmaiou`, `sangramento`, `sangrando`, `convulsao`, `suicidio`, `me matar`, `avc`, `infarto`. Resposta contém `192` e `pronto-socorro`; entra na fila humana com `prioridade: "alta"` e `motivo: "emergencia"`. Não agenda nem registra nada.
2. **Alerta clínico** — palavras inteiras: `dormencia`, `dormente`, `formigamento`, `perda de forca`, `sem forca`, `perdi a forca`, `febre`, `irradia`, `irradiando`, `queda`, `caiu`, `tombo`, `inchaco`, `inchou`, `inchado`, `nao consigo andar`, `nao consigo mexer`, `perdi o controle`. Resposta contém `fisioterapeuta` e `192` e **não** contém orientação (nada de "faça", "tome", "alongue"); fila humana `prioridade: "alta"`, `motivo: "alerta clinico"`. Nada mais é registrado.
3. **Parar** — texto igual a `parar`, `sair` ou `pare`: paciente fica `nao_contatar`; resposta contém `não vai mais receber`. Nenhuma mensagem de saída (confirmação, retorno, campanha, espera, prescrição, lembrete de exercício) vai mais para esse telefone.
4. **Humano** — contém `atendente`, `humano` ou `falar com alguem`: fila humana `prioridade: "normal"`; resposta contém `atendente`.
5. **Fluxo em andamento** (agendamento pelo chat, abaixo) consome a mensagem.
6. **Resposta a pendência** — vale a **última mensagem da caixa de saída** (`/api/saida`) para o telefone, **se ela for de um dos três tipos abaixo** e ainda estiver **sem resposta** (`prescricao`, `explicacao`, `humano`, `campanha` e `retorno` não são pendência: uma delas por último = sem pendência). "Sem resposta" quer dizer: `confirmacao` → o agendamento ainda está `agendado`; `espera` → o pedido ainda está `ofertado`; `exercicio` → ainda não há registro com `dor` para o paciente na data da mensagem. O texto normalizado é comparado por **igualdade**; texto que não casa nenhuma opção segue para as regras seguintes (a pendência continua):
   - `confirmacao`: igual a `1`, `sim` ou `confirmo` → status `confirmado`, resposta contém `confirmad`; igual a `2`, `cancelar` ou `nao` → `cancelado` (dispara espera), resposta contém `cancelad`.
   - `espera`: igual a `1` ou `sim` → agenda **exatamente o par (`inicio`, `profissional`) ofertado** (seção 7) se esse profissional ainda estiver livre nesse horário (resposta contém `agendad`; o pedido vira `atendido`); senão resposta contém `ocupado` — **mesmo que outro profissional esteja livre** no mesmo horário.
   - `exercicio` (lembrete, seção 22): texto que é só um número inteiro de `0` a `10` → registra **dor** desse valor **com os mesmos efeitos da regra 8** (resposta contém `registrad`; se `N ≥ dor_alerta`, fila humana `alta` com `motivo: "dor N"` e resposta com `fisioterapeuta` e `192`). `fiz` / `nao fiz` / `dor N` seguem a regra 8.
7. **Lembrete** — paciente com prescrição ativa e texto que contém a palavra `lembrete`: se contém `sem lembrete` → desliga (`lembrete_ativo: false`); senão → liga na hora `\d{1,2}:\d{2}` lida do **texto original** (antes de normalizar; a primeira ocorrência), ou em `lembrete_hora_padrao` se o texto não traz hora (`lembrete` sozinho). Hora válida = `00 ≤ HH ≤ 23` e `00 ≤ MM ≤ 59`, guardada com dois dígitos (`7:30` → `07:30`); hora inválida (ex.: `25:99`) → resposta contém `lembrete` e nada muda. Resposta contém `lembrete` e, ao ligar, a hora `HH:MM`. Sem prescrição ativa → cai na regra 12.
8. **Adesão e dor** — paciente cadastrado (telefone conhecido): `nao fiz` ou `nao consegui` → `fez: false`; senão `fiz` → `fez: true` (**`nao fiz` tem precedência**: `nao fiz tudo` é `fez: false`, apesar de conter `fiz`); os dois exigem prescrição ativa (sem ela → regra 12). `dor N` (N inteiro 0–10, as duas palavras seguidas) → `dor: N` (não exige prescrição). Um texto pode trazer os dois (`fiz, dor 3`). Tudo no **dia do relógio do processo** (seção 23). Resposta contém `registrad`. Se `N ≥ dor_alerta`: fila humana `prioridade: "alta"`, `motivo: "dor N"`, e a resposta contém também `fisioterapeuta` e `192`. Telefone desconhecido → regra 12.
9. **Exercício** — o texto contém o `nome` ou um `apelido` (com a mesma normalização do texto: `Bird-dog` casa `bird dog`) de um exercício **ativo** do catálogo; mais de um casa → o de maior número de palavras no termo casado, empate → o primeiro na ordem do catálogo. Se o exercício está na **prescrição ativa** do paciente: resposta com o nome, os `passos` numerados (`1. ...`), a linha `Pare se: <pare_se separados por "; ">` e o link `<PUBLIC_URL>/exercicios/<id>` (sem `PUBLIC_URL`, só `/exercicios/<id>`); essa resposta **também entra na caixa de saída** como `tipo: "explicacao"` (`status: "simulado"` sem Evolution; com Evolution, seção 17). Se não está prescrito (ou o telefone não tem cadastro/prescrição): resposta contém `fale com seu fisioterapeuta` e `atendente`, **sem** passos. Texto com a palavra `exercicio`/`exercicios` sem casar nome: lista os exercícios prescritos (`- <nome> — <link>`), ou a mesma resposta de "não prescrito".
10. **Agendar** — contém `agendar`, `marcar` ou `consulta`: inicia o fluxo.
11. **FAQ** — palavras significativas de alguma pergunta do FAQ (palavras normalizadas com ≥ 3 letras, fora desta lista **fechada**, a mesma do molde: `que qual quais como onde para por com sem uma uns umas dos das seu sua seus suas voce voces vcs nos eles elas tem`): se ≥ 60 % delas aparecem no texto, responde **exatamente** a `resposta` daquele item (só ela, uma mensagem). Mais de um item casa → o de maior %; empate → o primeiro do FAQ.
12. **Não entendi** — resposta contém `não entendi` e oferece `atendente`. Na **segunda** seguida sem entender, entra na fila humana (`normal`) automaticamente.

**Fluxo de agendamento pelo chat** (estado por telefone, persistido):
- telefone sem paciente → pergunta o nome (resposta contém `nome`); a próxima mensagem vira o nome e o paciente é criado (`consentimento_marketing: false`). Paciente conhecido não ouve pergunta de nome.
- lista os serviços ativos numerados `1 - <nome>` na ordem de cadastro;
- escolhido o número, oferece os **3 primeiros** horários livres a partir de `agora + antecedencia_min_horas`, dentro de `janela_dias`, em todos os profissionais, ordem da seção 5; cada linha `N) DD/MM HH:MM com <nome do profissional>`;
- escolhido o número, cria o agendamento (vinculado ao plano ativo do serviço, se houver); resposta contém `agendad`, `DD/MM` e `HH:MM`.
- número inválido em qualquer passo → repete as opções. `cancelar` dentro do fluxo → sai do fluxo.
- O bot **nunca** inventa preço, diagnóstico, remédio ou exercício: fora do FAQ e da prescrição cai na regra 12.

Enquanto um atendimento humano do telefone estiver `aberto` (seção 18), o bot não responde (`respostas: []`), exceto as regras 1 e 2 — que respondem normalmente, **não abrem um segundo atendimento** (há no máximo um `aberto` por telefone), elevam a `prioridade` do aberto para `alta` e repassam a mensagem ao grupo (seção 18).

## 7. Lista de espera

Ao cancelar (pela API ou pela conversa), o primeiro pedido de espera ainda não atendido com o mesmo `servico` e a mesma `data` do horário liberado (ordem de criação), cujo paciente não esteja `nao_contatar`, recebe mensagem `tipo: "espera"` contendo `HH:MM` do horário e `1`. A oferta é o par (`inicio`, `profissional`) do agendamento cancelado e fica guardada com o pedido, que passa a `ofertado` (não recebe outra oferta do mesmo horário); aceitar (regra 6 da seção 6) agenda esse par exato, e o pedido vira `atendido`.

## 8. Confirmação e retorno (`POST /api/tarefas/rodar`)

- **Confirmação:** todo agendamento `agendado` com `agora < inicio ≤ agora + confirmacao_horas` que ainda não recebeu confirmação → mensagem `tipo: "confirmacao"` com `agendamento_id`. Texto contém o nome do serviço, `DD/MM`, `HH:MM`, `1` (confirmar) e `2` (cancelar). **Não contém valor em R$.**
"""Testes de aceitação caixa-preta do atende-fisioterapia (contrato: docs/ESPECIFICACAO.md).

Sobem `./atende serve --porta 0 --dados <tmp>` com relógio fixo e falam só HTTP/CLI,
então valem para qualquer linguagem de implementação.
"""
import json
import os
import pathlib
import shutil
import signal
import subprocess
import threading
import time
import unicodedata
import urllib.error
import urllib.request

import pytest

RAIZ = pathlib.Path(__file__).resolve().parent.parent
FIXTURE = pathlib.Path(__file__).resolve().parent / "fixtures" / "clinica.json"
TOKEN = "segredo-teste"
AGORA = "2026-10-06T09:00"  # terça-feira (conferido: datetime.date(2026,10,6).weekday() == 1)
PUBLIC_URL = "https://fisio.exemplo"  # só nos testes; o código nunca traz URL

IDS_OBRIGATORIOS = ["ponte", "alongamento-isquiotibiais", "rotacao-ombro-bastao", "pendulo-codman",
                    "retracao-cervical", "gato-camelo", "agachamento-parede", "elevacao-calcanhar",
                    "abducao-quadril-deitado", "prancha-modificada", "bird-dog", "mobilidade-tornozelo"]


def norm(s):
    return "".join(c for c in unicodedata.normalize("NFD", s.lower()) if unicodedata.category(c) != "Mn")


class Cliente:
    def __init__(self, base):
        self.base = base

    def req(self, metodo, rota, corpo=None, token=TOKEN):
        dados = None if corpo is None else json.dumps(corpo).encode()
        r = urllib.request.Request(self.base + rota, data=dados, method=metodo)
        if dados is not None:
            r.add_header("Content-Type", "application/json")
        if token:
            r.add_header("X-Token", token)
        try:
            with urllib.request.urlopen(r, timeout=10) as resp:
                texto = resp.read().decode()
                return resp.status, (json.loads(texto) if texto and "json" in resp.headers.get("Content-Type", "") else texto)
        except urllib.error.HTTPError as e:
            texto = e.read().decode()
            try:
                return e.code, json.loads(texto)
            except ValueError:
                return e.code, texto

    def get(self, rota, **kw):
        return self.req("GET", rota, **kw)

    def post(self, rota, corpo=None, **kw):
        return self.req("POST", rota, {} if corpo is None else corpo, **kw)

    def put(self, rota, corpo, **kw):
        return self.req("PUT", rota, corpo, **kw)

    def delete(self, rota, **kw):
        return self.req("DELETE", rota, **kw)

    def bruto(self, rota):
        """GET sem decodificar: devolve (status, content-type, bytes)."""
        try:
            with urllib.request.urlopen(self.base + rota, timeout=10) as resp:
                return resp.status, resp.headers.get("Content-Type", ""), resp.read()
        except urllib.error.HTTPError as e:
            return e.code, e.headers.get("Content-Type", ""), e.read()

    # atalhos (usam padrões do fixture; no verificar-independente tudo vai explícito)
    def paciente(self, nome="Maria Silva", telefone="(41) 99999-0001", marketing=False):
        st, r = self.post("/api/pacientes", {"nome": nome, "telefone": telefone, "consentimento_marketing": marketing})
        assert st in (200, 201), (st, r)
        return r["id"]

    def agenda(self, paciente_id, inicio, servico="sessao", profissional=None, plano_id=None):
        corpo = {"paciente_id": paciente_id, "servico": servico, "inicio": inicio}
        if profissional:
            corpo["profissional"] = profissional
        if plano_id is not None:
            corpo["plano_id"] = plano_id
        return self.post("/api/agendamentos", corpo)

    def presenca(self, ag_id, compareceu):
        st, r = self.post(f"/api/agendamentos/{ag_id}/presenca", {"compareceu": compareceu})
        assert st == 200, (st, r)
        return r

    def plano(self, paciente_id, servico="sessao", sessoes=10, frequencia=2, profissional=None):
        corpo = {"paciente_id": paciente_id, "servico": servico, "sessoes_previstas": sessoes, "frequencia_semanal": frequencia}
        if profissional:
            corpo["profissional"] = profissional
        st, r = self.post("/api/planos", corpo)

